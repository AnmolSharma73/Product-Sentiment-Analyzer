# ─────────────────────────────────────────────────────────────────────────────
# Customer Insights Copilot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_ENV=development
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Database (SQLite default — replace with PostgreSQL DSN for production)
DATABASE_URL=sqlite:///./data/copilot.db

# Redis (optional — only needed for async batch jobs)
REDIS_URL=redis://localhost:6379/0
ENABLE_ASYNC_JOBS=false

# ML Models
SENTIMENT_MODEL=vader
ABSA_MODEL_PATH=yangheng/deberta-v3-base-absa-v1.1

# Embeddings & Vector Store (all offline — no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/faiss_index
RETRIEVAL_TOP_K=10
SIMILARITY_THRESHOLD=0.35

# LLM (optional — application works fully without this)
# Supported providers: openai, anthropic
# If not set, rule-based fallback is used automatically.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# MLflow experiment tracking (optional)
ENABLE_EXPERIMENT_TRACKING=false
MLFLOW_TRACKING_URI=./data/mlruns
