# ============================================================
# Product Sentiment Analyzer — Environment Variables
# ============================================================
# Copy this file to .env and fill in your API key:
#   cp .env.example .env
# ============================================================

# Anthropic Claude API Key (required for AI Insights tab)
ANTHROPIC_API_KEY=your_key_here

# Optional: Toggle BERT model usage (set to "true" to enable)
USE_BERT=false

# Optional: Claude model to use
CLAUDE_MODEL=claude-sonnet-4-20250514
